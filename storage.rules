rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Mirror frames: strictly no direct client write; upload only via Cloud Function signed upload URL.
    // Parents read strictly via short-lived (max 10 min) signed download URLs generated by createMirrorUploadUrl / fetchMirrorSession.
    match /mirror/{familyId}/{allPaths=**} {
      allow read: if false; // Direct SDK reads disabled; accessed only via short-lived signed URLs generated by backend
      allow write: if false; // Direct client writes prohibited; uploads use short-lived v4 signed URLs
    }

    // Homework attachments (e.g. worksheet photos)
    match /homework/{familyId}/{childId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.familyId == familyId;
      allow write: if request.auth != null 
        && request.auth.token.familyId == familyId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
